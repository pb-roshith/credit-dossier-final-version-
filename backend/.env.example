# Mistral AI Configuration
MISTRAL_API_KEY=your_mistral_api_key_here
# For Windows local use, migrate secrets from this file into the DPAPI/AES-GCM
# store with: python -m app.local_secrets .env backend MISTRAL_API_KEY DATABASE_URL
# Saved beta Observability regression judge used for the narrative confidence score.
# Configure the judge with the same maximum value specified below (normally 100).
MISTRAL_ACCURACY_JUDGE_ID=
MISTRAL_ACCURACY_JUDGE_MAX_SCORE=100

# Local company-document MCP
MCP_SSE_URL=http://127.0.0.1:8001/sse

# Database Configuration
# Local PostgreSQL database used only by the backend application:
DATABASE_URL=postgresql+psycopg://postgres:your_password@127.0.0.1:5432/credit_dossier_backend

# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/credit_dossier

# Application Settings
APP_ENV=development
UPLOAD_DIR=./uploads
# Exact browser origins, separated by |. Production should list only the UI origin.
CORS_ALLOWED_ORIGINS=http://localhost:8080|http://localhost:5173|http://127.0.0.1:5173
# Set true only behind a trusted proxy that overwrites X-Forwarded-For.
AUDIT_TRUST_X_FORWARDED_FOR=false

# Report protection. Windows installations use a DPAPI-protected key file.
REPORT_MASK_SENSITIVE_DATA=true
DPAPI_KEY_FILE=./.data/report-tokenization-key.dpapi
# Non-Windows production: inject 32+ random bytes as URL-safe base64 from the
# host OS/cloud secret manager. Never commit the value.
REPORT_TOKENIZATION_KEY=

# Initial login accounts (created only when the user ID does not already exist)
INITIAL_RELATIONSHIP_MANAGER_USER_ID=manager
INITIAL_RELATIONSHIP_MANAGER_PASSWORD=
INITIAL_CREDIT_ANALYST_USER_ID=analyst
INITIAL_CREDIT_ANALYST_PASSWORD=
INITIAL_ADMIN_USER_ID=admin
INITIAL_ADMIN_PASSWORD=

# Absolute session timeouts. Admin must be shorter than both business roles.
SESSION_TIMEOUT_RELATIONSHIP_MANAGER_MINUTES=30
SESSION_TIMEOUT_CREDIT_ANALYST_MINUTES=30
SESSION_TIMEOUT_ADMIN_MINUTES=15

# Password policy (all character counts are minimums; use 0 to disable a class)
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_MIN_UPPERCASE=1
PASSWORD_MIN_LOWERCASE=1
PASSWORD_MIN_DIGITS=1
PASSWORD_MIN_SPECIAL=1

# Allowed recovery questions, separated by |. Configure at least three unique values.
SECURITY_QUESTIONS=What was the name of your first school?|What city were you born in?|What was the name of your first pet?|What is your oldest sibling's middle name?|What was the make of your first car?|What is the name of the street where you grew up?
